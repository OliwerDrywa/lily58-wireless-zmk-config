#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

&lt {
    flavor = "balanced";
    tapping-term-ms = <350>;
};

/ {
    combos { compatible = "zmk,combos"; };

    macros {
        muteall: muteall {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp FSLH &kp M &kp U &kp T &kp E &kp SPACE &kp A &kp L &kp L>;
            label = "MUTEALL";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "base";
            bindings = <
&none  &none  &none  &none  &none  &none                               &none  &none  &none      &none    &none     &none
&none  &kp Q  &kp W  &kp E  &kp R  &kp T                               &kp Y  &kp U  &kp I      &kp O    &kp P     &none
&none  &kp A  &kp S  &kp D  &kp F  &kp G                               &kp H  &kp J  &kp K      &kp L    &kp SEMI  &none
&none  &kp Z  &kp X  &kp C  &kp V  &kp B  &none             &muteall   &kp N  &kp M  &kp COMMA  &kp DOT  &kp FSLH  &none
                     &none  &none  &mo 2  &kp LEFT_SHIFT    &kp SPACE  &mo 1  &none  &none
            >;
        };

        lower {
            display-name = "num";
            bindings = <
&none   &none      &none      &none      &none      &none                            &none             &none              &none    &none         &none         &none
&none   &kp F1     &kp F2     &kp F3     &kp F4     &kp F5                           &kp F6            &kp F7             &kp F8   &kp F9        &kp F10       &trans
&none   &kp N1     &kp N2     &kp N3     &kp N4     &kp N5                           &kp N6            &kp N7             &kp N8   &kp N9        &kp N0        &trans
&trans  &kp LCTRL  &kp GRAVE  &kp MINUS  &kp EQUAL  &kp BACKSLASH  &trans    &trans  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp SQT  &kp LEFT_ALT  &kp LEFT_WIN  &trans
                              &none      &trans     &trans         &trans    &trans  &trans            &trans             &trans
            >;
        };

        higher {
            display-name = "nav";
            bindings = <
&none   &none           &none      &none         &none         &none                            &none           &none          &none         &none         &none             &none
&trans  &kp ESCAPE      &kp LC(S)  &kp LC(F)     &kp LC(A)     &kp TAB                          &kp HOME        &kp PAGE_DOWN  &kp PG_UP     &kp END       &kp BACKSPACE     &trans
&trans  &kp LEFT_SHIFT  &kp LCTRL  &kp LEFT_ALT  &kp LEFT_GUI  &kp DELETE                       &kp LEFT        &kp DOWN       &kp UP        &kp RIGHT     &kp DEL           &trans
&trans  &kp LC(Z)       &kp LC(X)  &kp LC(C)     &kp LC(V)     &none       &trans    &trans     &kp C_PREVIOUS  &kp K_NEXT     &kp C_VOL_DN  &kp C_VOL_UP  &kp C_PLAY_PAUSE  &trans
                                   &trans        &trans        &trans      &trans    &kp ENTER  &trans          &trans         &trans
            >;
        };

        lowest {
            display-name = "media";
            bindings = <
&none   &none  &none       &none         &none         &none                                 &none         &none         &none         &none   &none   &none
&none   &none  &none       &none         &none         &none                                 &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &trans  &trans  &bt BT_CLR
&trans  &none  &kp C_PREV  &kp C_VOL_DN  &kp C_VOL_UP  &kp C_NEXT                            &trans        &trans        &trans        &trans  &trans  &trans
&none   &none  &none       &kp C_MUTE    &kp C_PP      &none       &trans    &bt BT_CLR_ALL  &trans        &trans        &trans        &trans  &trans  &trans
                           &none         &none         &none       &trans    &trans          &trans        &trans        &trans
            >;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        l3 {
            if-layers = <2 1>;
            then-layer = <3>;
        };
    };
};
